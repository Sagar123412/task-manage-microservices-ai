# =========================================================
# Root reference env file for local development.
# Copy values into each app's own .env file as needed.
# =========================================================

# Shared (all backend services / gateway)
NODE_ENV=development
LOG_LEVEL=info

# Gateway (gateway/.env)
GATEWAY_PORT=4000
USERS_SERVICE_URL=http://127.0.0.1:4002
AUTH_SERVICE_URL=http://127.0.0.1:4003
TODO_SERVICE_URL=http://127.0.0.1:4005

# Auth Service (services/auth-service/.env)
AUTH_PORT=4003
DATABASE_URL=postgresql://postgres:1212@localhost:5432/taskmanager
JWT_ACCESS_SECRET=replace_with_min_16_characters
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_with_min_16_characters
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_DAYS=7
VERIFY_EMAIL_BASE_URL=http://127.0.0.1:3000/verify-email
RABBITMQ_URL=amqp://127.0.0.1:5672
EVENT_EXCHANGE_NAME=app.events

# Users Service (services/users-service/.env)
USERS_PORT=4002

# Todo Service (services/todo-service/.env)
TODO_PORT=4005
MONGODB_URI=mongodb://127.0.0.1:27017/taskmanager_todos
REDIS_URL=redis://127.0.0.1:6379

# Notification Service (services/notification-service/.env)
NOTIFICATION_PORT=4004
NOTIFICATION_QUEUE_NAME=notification.events
NOTIFICATION_RETRY_QUEUE_NAME=notification.events.retry
NOTIFICATION_DEAD_QUEUE_NAME=notification.events.dead
NOTIFICATION_RETRY_DELAY_MS=10000
NOTIFICATION_MAX_RETRIES=3
EMAIL_FROM=no-reply@taskmanager.local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Client (client/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
